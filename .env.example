# Copy to .env.local for local dev. Never commit real values.
# Deploy credentials live in GitHub secrets (see DEPLOYMENT.md), not here.
#
# Inquiry delivery (Phase 3). On Cloudflare these are Worker secrets, not env files.
# For local runs, Cloudflare's published always-pass Turnstile test keys work:
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Real values: leave empty here and set them as Worker secrets (DEPLOYMENT.md).
RESEND_API_KEY=
INQUIRY_TO=
# Optional: point Resend calls at a local mock instead of api.resend.com.
# RESEND_API_BASE=http://localhost:4010
